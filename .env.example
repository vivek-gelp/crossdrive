# Copy to .env.local for local development, or set these in the Vercel project.
# The legacy VAULT_ prefix is still accepted for every CROSSDRIVE_ variable.

# --- Required ---------------------------------------------------------------
# Google OAuth client (Web application) from your own Google Cloud project, copied from
# Google Cloud Console > Google Auth Platform > Clients. The client ID ends in .apps.googleusercontent.com;
# current client secrets start with GOCSPX-. /setup fails placeholder text such as PASTE_CLIENT_ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. Generate each secret separately:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Signs OAuth tokens; rotating it signs out every client.
CROSSDRIVE_JWT_SECRET=
# Encrypts stored refresh tokens; losing it means reconnecting every account.
CROSSDRIVE_ENC_KEY=
# Comma-separated Google emails allowed to sign in and administer.
CROSSDRIVE_ALLOWED_EMAILS=
# Public URL of the deployment, no trailing slash. Optional on Vercel: when unset, the production domain
# (VERCEL_PROJECT_PRODUCTION_URL) is used. Set it for a custom domain; it must be the deployment's own
# address, never the GitHub repository URL. Defaults to http://localhost:3000 elsewhere.
CROSSDRIVE_BASE_URL=http://localhost:3000
# Set automatically when you attach a Vercel Blob store (private).
BLOB_READ_WRITE_TOKEN=

# --- Optional ---------------------------------------------------------------
# Comma-separated bearer tokens for scripts and other clients (full access / read tools only).
CROSSDRIVE_STATIC_TOKENS=
CROSSDRIVE_READONLY_TOKENS=
# Comma-separated recipient allowlist for mail_send and mail_reply (empty = no restriction).
CROSSDRIVE_MAIL_ALLOWED_RECIPIENTS=
# Set to date-entity to enforce YYYY-MM-DD_Company_WhatItIs.ext on uploads and renames (default: off).
CROSSDRIVE_NAMING_RULE=
# Name of the inbox folder that put defaults to and inbox reports.
CROSSDRIVE_INBOX_FOLDER=
# Shown on the privacy and terms pages.
CROSSDRIVE_OPERATOR=
CROSSDRIVE_CONTACT=

# --- Beta providers (optional) ---------------------------------------------------
# OneDrive and Dropbox support is BETA and has not yet been tested against live accounts. See docs/providers.md.
# Microsoft (Azure) app registration; redirect URI <CROSSDRIVE_BASE_URL>/connect/microsoft/callback.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# common (default: personal and work/school), organizations, consumers, or a tenant id/domain.
MS_TENANT=
# Dropbox app key and secret; redirect URI <CROSSDRIVE_BASE_URL>/connect/dropbox/callback.
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# --- Set by Vercel, do not add yourself ----------------------------------------
# VERCEL_PROJECT_PRODUCTION_URL is the base URL when CROSSDRIVE_BASE_URL is unset. VERCEL_ENV and
# VERCEL_PROJECT_PRODUCTION_URL are also read to warn when CROSSDRIVE_BASE_URL does not match the production domain.

# --- Not read by the server -------------------------------------------------------
# scripts/bulk-upload.mjs runs on your own machine and reads CROSSDRIVE_URL (your
# deployment's base URL, or pass --url) and CROSSDRIVE_TOKEN (one of the
# CROSSDRIVE_STATIC_TOKENS values) from its own environment.
